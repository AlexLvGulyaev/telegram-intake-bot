# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram chat or group ID where tickets/leads are sent (e.g., -1001234567890)
OPERATOR_CHAT_ID=your_operator_chat_id

# OpenAI API key for LLM calls
OPENAI_API_KEY=your_openai_api_key

# OpenAI model name (default: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# OpenAI API base URL (default: https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# Session storage backend: memory (default) or postgres
# For postgres, set DATABASE_URL, e.g.:
# DATABASE_URL=postgresql://tib_user:tib_password@localhost:5432/tib_db
SESSION_STORAGE_TYPE=memory

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
